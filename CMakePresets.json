{
    "version": 4,
    "configurePresets": [
        {
            "name": "msvc",
            "hidden": true,
            "displayName": "Visual Studio Community 2026 Release - amd64",
            "description": "Using compilers for Visual Studio 18 2026 (x64 architecture)",
            "generator": "Visual Studio 18 2026",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}\\scripts\\buildsystems\\vcpkg.cmake"
            }
        },
        {
            "name": "msvc-offline",
            "hidden": true,
            "inherits": "msvc",
            "displayName": "msvc-offline PLEASE USE THIS FOR OFFLINE CODING",
            "description": "Consumes exported sdk by setting manifest mode=OFF",
            
            "cacheVariables": {
                "VCPKG_MANIFEST_MODE": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-debug",
            "displayName": "Visual Studio Community 2026 Release - amd64 - Debug",
            "configurePreset": "msvc",
            "configuration": "Debug"
        },
        {
            "name": "msvc-offline-debug",
            "displayName": "MSVC Offline - amd64 - Debug",
            "configurePreset": "msvc-offline",
            "configuration": "Debug"
        }
    ]
}